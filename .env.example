# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Mock mode toggle (true = use mock responses, false = use real Gemini API)
NEXT_PUBLIC_MOCK_MODE=true

# 11Labs Voice Agent Configuration
# Get these from: https://elevenlabs.io/app
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_11labs_api_key_here
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id_here
